// Fitness & Self-Improvement OS — Slice 0 (Project Bootstrapping)
// Postgres 18 via Docker Compose + Prisma ORM 7.
// Multi-user-ready, auth-less for the MVP: every row is owned via userId, but
// getCurrentUser() returns a single seeded dev user until Auth.js is added.

generator client {
  provider = "prisma-client" // not prisma-client-js (deprecated in v7)
  output   = "../src/generated/prisma" // `output` is required in Prisma 7
}

datasource db {
  provider = "postgresql"
  // Connection string lives in prisma.config.ts (v7 canonical).
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------
// Minimal, auth-less placeholder. Deliberately shaped like Auth.js's
// AdapterUser (id/email/name/image) so adding auth later is purely additive.
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  name         String?
  image        String?
  timezone     String   @default("UTC") @db.VarChar(64) // IANA, e.g. "Asia/Kolkata"
  goalWeightKg Decimal? @map("goal_weight_kg") @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  dailyMetrics    DailyMetric[]
  habits          Habit[]
  workoutSessions WorkoutSession[]
  routines        Routine[]
  measurementTypes MeasurementType[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Slice 1 — Daily metrics & macros
// ---------------------------------------------------------------------------
// One row per user per calendar day (user-local). All measurement columns are
// nullable: a day can be "weighed only" or "macros only", and NULL means
// "unknown" so averages/sums ignore it instead of being dragged toward 0.
model DailyMetric {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  weightKg  Decimal? @map("weight_kg") @db.Decimal(5, 2)
  calories  Int?
  proteinG  Int?     @map("protein_g")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per user per local day, and the index behind the 30-day trend.
  // Requires userId NOT NULL: Postgres treats NULLs as distinct, so a nullable
  // userId would let duplicate "anonymous" rows for the same date through.
  @@unique([userId, date])
  @@map("daily_metrics")
}

// ---------------------------------------------------------------------------
// Slice 2 — Habit engine
// ---------------------------------------------------------------------------
// Habit = the definition (created once, archived rather than deleted).
model Habit {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String    @db.VarChar(120)
  description String?   @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@unique([userId, name]) // no two identical habits on one checklist
  @@index([userId, archivedAt]) // "my active habits" checklist query
  @@map("habits")
}

// HabitLog = the per-day completion fact, one row per habit per day.
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String   @map("habit_id")
  date      DateTime @db.Date
  completed Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  // Makes check/uncheck a single idempotent upsert. Also the only index this
  // table needs: every read is habitId (+ date range) shaped.
  @@unique([habitId, date])
  @@map("habit_logs")
}

// ---------------------------------------------------------------------------
// Slice 3 — Workout & progressive overload
// ---------------------------------------------------------------------------
model WorkoutSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  name         String    @db.VarChar(80) // "Push" | "Pull" | "Legs" | free text
  notes        String?   @db.Text
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  // Set for a workout planned ahead of time. NULL = not scheduled (the normal
  // "start now" case). A session dated in the future is NOT the active one —
  // every "in progress" query has to exclude it.
  scheduledFor DateTime? @map("scheduled_for") @db.Date
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3) // NULL = in progress
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets      WorkoutSet[]
  exercises WorkoutExercise[]

  @@index([userId, startedAt]) // session history list
  @@index([userId, completedAt]) // Slice 4 "last completed workout"
  @@index([userId, scheduledFor]) // "upcoming workouts" list
  @@map("workout_sessions")
}

// One exercise inside a session — the card the logging screen is built around.
// It exists BEFORE any set is logged, which is what makes "add a blank exercise
// and fill it in as you go" possible; a set-derived list cannot represent an
// empty card. `exerciseId` links to the catalog when the user picked one, and is
// NULL for a custom name (or if the catalog row is ever removed).
model WorkoutExercise {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  exerciseId String?  @map("exercise_id")
  name       String   @db.VarChar(120)
  nameKey    String   @map("name_key") @db.VarChar(120)
  // Display order within the session; new blocks append at max + 1.
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets     WorkoutSet[]

  // One block per exercise per session: "Bench Press" and "bench press" are the
  // same exercise, matching the key the overload history is built on.
  @@unique([sessionId, nameKey])
  @@index([sessionId, position])
  @@map("workout_exercises")
}

// A logged set. `workoutExerciseId` is the block it belongs to; the denormalised
// `exerciseName`/`exerciseKey` stay because the progressive-overload query reads
// them across sessions without joining every block.
//
// exerciseId is OPTIONAL on purpose: the catalog is global and read-only, while
// sets are user-authored. A set logged from the library points at a catalog row;
// a hand-typed custom exercise keeps it NULL, and deleting/rebuilding the
// catalog must never cascade into someone's training history (hence SetNull).
model WorkoutSet {
  id                String   @id @default(cuid())
  sessionId         String   @map("session_id")
  workoutExerciseId String   @map("workout_exercise_id")
  exerciseId        String?  @map("exercise_id")
  exerciseName      String   @map("exercise_name") @db.VarChar(120)
  exerciseKey       String   @map("exercise_key") @db.VarChar(120)
  setNumber         Int      @map("set_number") // 1-based, per block
  weightKg          Decimal  @default(0) @map("weight_kg") @db.Decimal(5, 2) // 0 = bodyweight
  reps              Int
  rpe               Decimal? @db.Decimal(3, 1) // 1.0–10.0 in 0.5 steps; NULL = unrated
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session         WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  exercise        Exercise?       @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  // Idempotent "log a set" (safe on double-submit) + session detail reads.
  @@unique([sessionId, exerciseKey, setNumber])
  @@index([exerciseKey]) // per-exercise history / "previous top set"
  @@index([exerciseId]) // catalog → "my history with this exercise"
  @@index([workoutExerciseId]) // a block's table
  @@map("workout_sets")
}

// ---------------------------------------------------------------------------
// Exercise catalog (global, seeded from prisma/data/exercises.json)
// ---------------------------------------------------------------------------
// Vendored from the Gym Visual dataset (1,324 rows), read-only at runtime and
// shared by every user: no userId, no ownership, no user-specific columns.
//
// `nameKey` is deriveExerciseKey(name) — the same trim/collapse/lowercase rule
// WorkoutSet.exerciseKey uses — so a library pick and a hand-typed name land on
// one key and the progressive-overload history query keeps working unchanged.
//
// imagePath/gifPath are populated now but not served in this slice, so enabling
// media later is a UI change rather than a migration.
model Exercise {
  id               String   @id @default(cuid())
  datasetId        String   @unique @map("dataset_id") @db.VarChar(8)
  name             String   @db.VarChar(120)
  nameKey          String   @map("name_key") @db.VarChar(120)
  category         String   @db.VarChar(40)
  bodyPart         String   @map("body_part") @db.VarChar(40)
  equipment        String   @db.VarChar(40)
  target           String   @db.VarChar(60)
  muscleGroup      String?  @map("muscle_group") @db.VarChar(60)
  secondaryMuscles String[] @map("secondary_muscles")
  instructionsEn   String   @map("instructions_en") @db.Text
  stepsEn          String[] @map("steps_en")
  imagePath        String?  @map("image_path") @db.VarChar(200)
  gifPath          String?  @map("gif_path") @db.VarChar(200)
  attribution      String   @db.VarChar(120)
  youtubeUrl       String?  @map("youtube_url") @db.VarChar(300)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sets WorkoutSet[]
  workoutExercises WorkoutExercise[]
  routineExercises RoutineExercise[]

  // Prefix search on the normalized key (the library's `q`) and the three facet
  // filters. Each is a cheap b-tree scan over 1.3k rows.
  @@index([nameKey])
  @@index([bodyPart])
  @@index([equipment])
  @@index([target])
  @@map("exercises")
}

// ---------------------------------------------------------------------------
// Slice 12 — Routines (reusable workout templates + weekly schedule)
// ---------------------------------------------------------------------------
// A routine is the plan ("Push", "Pull", "Legs"); a WorkoutSession is one
// execution of it. Starting a routine COPIES its exercises into the session, so
// editing a routine never rewrites workouts you already did.
model Routine {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String    @db.VarChar(80)
  notes       String?   @db.Text
  // Weekdays this routine is planned for, 0 = Sunday … 6 = Saturday (matching
  // JS `Date.getDay()`). Empty = an unscheduled template you start by hand.
  // An array rather than seven booleans: the query is "does this routine run on
  // day N", which is `weekdays has N`.
  weekdays    Int[]     @default([])
  position    Int       @default(0)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]

  // "Push" and "push" would be two routines otherwise.
  @@unique([userId, name])
  @@index([userId, position])
  @@map("routines")
}

model RoutineExercise {
  id         String  @id @default(cuid())
  routineId  String  @map("routine_id")
  exerciseId String? @map("exercise_id")
  name       String  @db.VarChar(120)
  nameKey    String  @map("name_key") @db.VarChar(120)
  position   Int     @default(0)
  // Planned working sets; NULL = no target ("just do what you feel").
  targetSets Int?    @map("target_sets")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  routine  Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@unique([routineId, nameKey])
  @@index([routineId, position])
  @@map("routine_exercises")
}

// ---------------------------------------------------------------------------
// Slice 13 — Body measurements (waist, chest, arm … as many as the user wants)
// ---------------------------------------------------------------------------
// A type is user-defined ("Waist", "Chest", "Left arm") with its own unit, so
// the app never hardcodes a body-part list. Entries are one per type per day.
model MeasurementType {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String    @db.VarChar(60)
  // Free-form short unit ("cm", "in", "%"). Kept as text because users mix
  // metric and imperial per measurement and no conversion is implied.
  unit       String    @db.VarChar(16)
  position   Int       @default(0)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries MeasurementEntry[]

  @@unique([userId, name])
  @@index([userId, archivedAt])
  @@map("measurement_types")
}

model MeasurementEntry {
  id        String   @id @default(cuid())
  typeId    String   @map("type_id")
  date      DateTime @db.Date
  value     Decimal  @db.Decimal(6, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  type MeasurementType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  // One reading per measurement per day; re-entering a date is an upsert.
  @@unique([typeId, date])
  @@index([typeId, date])
  @@map("measurement_entries")
}
